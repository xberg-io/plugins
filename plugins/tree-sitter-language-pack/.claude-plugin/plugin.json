  "license": "MIT",
  "keywords": [
    "tree-sitter",
    "code-intelligence",
    "parsing",
    "chunking",
    "static-analysis"
  ],
  "mcpServers": {
    "tree-sitter-language-pack": {
      "command": "${CLAUDE_PLUGIN_ROOT}/scripts/mcp-launch.sh",
      "args": [
        "mcp",
        "--transport",
        "stdio"
      ]
    }
  }
